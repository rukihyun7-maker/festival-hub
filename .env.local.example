# Supabase 프로젝트 설정
# https://supabase.com/dashboard/project/_/settings/api 에서 확인

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxx

# 인근지역 정보 통합 (Priority 2 · docs/LOCAL_INFO_INTEGRATION.md 참고)
# 공공데이터포털 · https://www.data.go.kr
DATA_GO_KR_API_KEY=
# 서울 열린데이터광장 · https://data.seoul.go.kr
DATA_SEOUL_API_KEY=
# 대학알리미 · https://openapi.academyinfo.go.kr
ACADEMYINFO_API_KEY=
# 카카오 로컬 (지오코딩) · https://developers.kakao.com
KAKAO_REST_API_KEY=

# 실제 사용
# 1. Supabase에서 새 프로젝트 생성
# 2. 위 두 값 복사
# 3. 이 파일을 .env.local 로 복사한 뒤 값 붙여넣기
# 4. supabase/schema.sql → policies.sql → seed.sql 순서로 SQL Editor 실행
# 5. npm run dev
